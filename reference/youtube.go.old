package main

import (
	"bufio"
	"fmt"
	"log"
	"os"
	"os/exec"
	"path/filepath"
	"regexp"
	"strconv"
	"strings"

	"github.com/joho/godotenv"
)

// isValidateURL checks if the provided URL is a valid YouTube URL.
func isValidateURL(url string) bool {
	urlPattern := `^(https?\:\/\/)?(www\.youtube\.com|youtu\.?be)\/.+`
	re := regexp.MustCompile(urlPattern)
	return re.MatchString(url)
}

// removeNonASCII removes non-ASCII characters from text and returns a clean string.
func removeNonASCII(text string) string {
	asciiText := strings.Map(func(r rune) rune {
		if r > 127 {
			return -1
		}
		return r
	}, text)
	return asciiText
}

// getVideoTitle fetches the video title using yt-dlp without downloading the file.
func getVideoTitle(url string) (string, error) {
	cmd := exec.Command("yt-dlp", "--get-title", url)
	output, err := cmd.Output()
	if err != nil {
		return "", fmt.Errorf("error getting video title: %w", err)
	}
	// Return the title, trimming any newlines or spaces
	return strings.TrimSpace(string(output)), nil
}

// downloadAudio downloads the audio stream from a YouTube video using yt-dlp and ffmpeg.
func downloadAudio(url, targetFolder string, bitrate, channels, sampleRate int) {
	if !isValidateURL(url) {
		log.Println("Invalid URL:", url)
		return
	}

	// Create the output folder if it doesn't exist
	if _, err := os.Stat(targetFolder); os.IsNotExist(err) {
		if err := os.Mkdir(targetFolder, os.ModePerm); err != nil {
			log.Fatalf("Error creating directory: %v", err)
		}
	}

	// Fetch video title for naming the output file
	videoTitle, err := getVideoTitle(url)
	if err != nil {
		log.Fatalf("Error fetching video title: %v", err)
	}

	sanitizedTitle := removeNonASCII(videoTitle)
	tempFilePath := filepath.Join(targetFolder, sanitizedTitle+".m4a")
	outputFilePath := filepath.Join(targetFolder, sanitizedTitle+".mp3")

	cmd := exec.Command("yt-dlp", "-f", "bestaudio", "--extract-audio", "--audio-format", "m4a", url, "-o", tempFilePath)
	cmd.Stdout = os.Stdout
	cmd.Stderr = os.Stderr

	fmt.Printf("Downloading audio for URL: %s\n", url)
	if err := cmd.Run(); err != nil {
		log.Fatalf("Error downloading audio: %v", err)
	}

	ffmpegCmd := exec.Command("ffmpeg", "-i", tempFilePath, "-ac", strconv.Itoa(channels), "-ar", strconv.Itoa(sampleRate), "-b:a", fmt.Sprintf("%dk", bitrate), outputFilePath)
	ffmpegCmd.Stdout = os.Stdout
	ffmpegCmd.Stderr = os.Stderr

	if err := ffmpegCmd.Run(); err != nil {
		log.Fatalf("Error processing audio file with ffmpeg: %v", err)
	}

	os.Remove(tempFilePath)

	fmt.Printf("Downloaded and saved audio for %s\n", sanitizedTitle)
}

// loadEnv loads environment variables from the .env file.
func loadEnv() {
	if err := godotenv.Load(".env"); err != nil {
		log.Fatalf("Error loading .env file")
	}
}

// readURLs reads URLs from a file and returns them as a slice of strings.
func readURLs(urlFile string) ([]string, error) {
	file, err := os.Open(urlFile)
	if err != nil {
		return nil, fmt.Errorf("error opening URL file: %w", err)
	}
	defer file.Close()

	var urls []string
	scanner := bufio.NewScanner(file)
	for scanner.Scan() {
		url := strings.TrimSpace(scanner.Text())
		if isValidateURL(url) {
			urls = append(urls, url)
		} else {
			fmt.Printf("Skipping invalid URL: %s\n", url)
		}
	}

	return urls, scanner.Err()
}

func main() {
	// Load environment variables from .env
	loadEnv()

	// Read environment variables and convert them to appropriate types
	bitrate, err := strconv.Atoi(os.Getenv("BITRATE"))
	if err != nil {
		log.Fatalf("Invalid BITRATE value in .env: %v", err)
	}

	channels, err := strconv.Atoi(os.Getenv("CHANNELS"))
	if err != nil {
		log.Fatalf("Invalid CHANNELS value in .env: %v", err)
	}

	sampleRate, err := strconv.Atoi(os.Getenv("SAMPLE_RATE"))
	if err != nil {
		log.Fatalf("Invalid SAMPLE_RATE value in .env: %v", err)
	}

	targetFolder := os.Getenv("TARGET_FOLDER")
	urlFile := os.Getenv("URL_FILE")

	// Read URLs from the specified file
	urls, err := readURLs(urlFile)
	if err != nil {
		log.Fatalf("Error reading URL file: %v", err)
	}

	// Download audio for each URL in the file
	for _, url := range urls {
		downloadAudio(url, targetFolder, bitrate, channels, sampleRate)
	}
}
